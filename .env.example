# Copy this file to .env and fill in real values before running Docker Compose
#   cp .env.example .env
#
# Only variables consumed by docker-compose.yml belong here; everything else
# is either hard-coded in the compose file or uses a sane default.

# ===== MySQL =====
MYSQL_DATABASE=data
MYSQL_ROOT_PASSWORD=change_me_root_password

# ===== Analytics service =====
LOG_LEVEL=info

# ===== JWT (backend) =====
# REQUIRED. Generate a fresh value with: openssl rand -base64 64
# (must be >= 32 bytes). Leaving the placeholder below uncommented makes the
# backend refuse to start on purpose - it is a known value and would make
# every token forgeable.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# ===== Ollama (AI assistant) =====
# Model pulled into the ollama container (see README: ollama pull ...)
OLLAMA_MODEL=llama3.2:3b
# Generous read timeout: the first request after an idle reload loads the model.
OLLAMA_TIMEOUT_SECONDS=180